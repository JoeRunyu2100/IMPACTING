{UTF-8}
Susceptible Human Population= INTEG (
	Chiku recovered susceptability rate+Deng recovered susceptability rate+YF recovered susceptability rate\
		-Chiku Biting rates-Dengue Biting rate-YF Bitin rate-Human Death rate+Human birth rate\
		,
		Human Population)
	~	People
	~	Human Population*((Deng PP biting rate-Deng weakening immunity rate)+(Chiku People \
		biting rate-Chiku weak immunity rate
		)+(Yellow fever pp biting rate-Yellow fever weak immunity rate))
	|

Urban sanitation effect= WITH LOOKUP (
	Urbanization Index,
		([(0,0)-(10,10)],(0,0.001),(0.2,0.009),(0.4,0.04),(0.6,0.09),(0.8,0.1),(1,0.3) ))
	~	Dmnl
	~		|

Effect of infected population= WITH LOOKUP (
	Total Infected Human Population,
		([(0,0)-(1000,1)],(0,0),(125.382,0.09649),(299.694,0.1711),(446.483,0.1974),(510.703\
		,0.2719),(629.969,0.3728),(795.107,0.4474),(892.966,0.5263),(990.826,0.6316) ))
	~	Dmnl
	~	RANDOM UNIFORM ( 0.04 , 0.1 ,1000 )
	|

Poor sanitation effect=
	(RANDOM UNIFORM ( 10 , 20 , 1000 ))/1000
	~	Dmnl
	~		|

