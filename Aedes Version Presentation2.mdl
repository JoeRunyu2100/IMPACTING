Chikungunya Infected HP= INTEG (
	MAX((Chikufever intriscic incubation rate-Chiku PP recovery rate-Chiku PP induced mortality rate\
		), 0),
		0)
	~	People
	~		|

ChikV Exposed mortality rate=ChikV Vector Exposed deaths*ChikuV Exposed Aedes Adults
	~	Aedes/Month
	~		|

Probability of vector ChikV infection from biting infected human=
	1
	~	Dmnl
	~		|

ChikV Incidence=
	Region Initial ChikV incidence+(Probability of vector ChikV infection from biting infected human\
		*(Chikungunya Infected HP/Human Population))
	~	Dmnl
	~		|

ChikV induced Mortality rate=ChikuV Infected Aedes Adults*ChikV Vector Infected deaths
	~	Aedes/Month
	~		|

Yellow Fever Vector to human contact=Yellow Fever Infected Aedes region density*(Host Daytime exposure\
		)
	~	1/Month
	~		|

YF Exposed mortality rate=YFV Vector Exposed deaths*YFV Exposed Aedes Adults
	~	Aedes/Month
	~		|

Aedes Chiku Competence=(Number of bites per Aedes per month*Chikungunya Prefered climate\
		)
	~	Dmnl
	~		|

YF Incidence=
	Region Initial Yellow fever incidence+(Probability of vector YF infection from biting infected human\
		*(YellowFever Infected HP/Human Population))
	~	Dmnl
	~		|

YF induced Mortality rate=YFV Infected Aedes Adults*YFV Vector Infected deaths
	~	Aedes/Month
	~		|

Dengue Infected HP= INTEG (
	MAX((Den Ae intriscic incubation rate-Deng PP recovery rate-Den PP induced mortality rate\
		), 0),
		0)
	~	People
	~		|

YellowFever Infected HP= INTEG (
	MAX((YF intriscic incubation rate-YF PP recovery rate-YF PP induced mortality rate),\
		 0),
		0)
	~	People
	~		|

Deng VBD Human deaths=Deng Exposed induced mortality rate+Den PP induced mortality rate
	~	People/Month
	~		|

Yellow Fever VBD Human deaths=YF Exposed induced mortality rate+YF PP induced mortality rate
	~	People/Month
	~		|

YF PP induced mortality rate=YellowFever Infected HP*Yellow fever infected deaths
	~	People/Month
	~		|

YF Aedes Competence=(Number of bites per Aedes per month*YF Prefered climate)
	~	Dmnl
	~		|

YF Exposed induced mortality rate=YellowFever Exposed HP*YF exposed mortalities
	~	People/Month
	~		|

YFV Infected Aedes Adults= INTEG (
	Aedes YF infectious rate-YF induced Mortality rate,
		0)
	~	Aedes
	~		|

Region Initial ChikV incidence=0.001
	~	Dmnl
	~		|

Region Initial Yellow fever incidence=0.001
	~	Dmnl
	~		|

YF PP recovery rate=YellowFever Infected HP*(YEllow Fever Applied treatment measures efficiency\
		*Human YF Immune system response rate)
	~	People/Month
	~		|

YF Prefered climate=
	IF THEN ELSE((Optimal Aedes VBD Climate effect:AND:Yellow Fever Climate factor>=1), \
		RANDOM UNIFORM(0.5, 1 , 100), 0)
	~	Month
	~		|

Yellow Fever Climate factor=
	((Regional Precipitation-YF Rainfall)/Regional Precipitation)+((Regional Humidity-YF Humidity\
		)/Regional Humidity)+((Regional Temperature-YF Temp)/Regional Temperature)
	~	Dmnl
	~		|

Probability of vector YF infection from biting infected human=
	1
	~	Dmnl
	~		|

Risk of Yellow Fever Infection= INTEG (
	YF Human contact infection rate-YF prevention rate,
		0)
	~	Dmnl
	~		|

Risk of Chikungunya Infection= INTEG (
	Chik Human contact infection rate-Chiku prevention rate,
		0)
	~	Dmnl
	~		|

Treatment Measures Index= INTEG (Healthcare availability rate-Healthcare affordability rate\
		,
		0)
	~	Dmnl
	~		|

Control Measures implemetation=1/12
	~	Dmnl
	~		|

VBD Awareness index= INTEG (Awareness increase rate-Awareness decrease rate,
		0)
	~	Dmnl
	~		|

Region Employment rate=0.0075
	~	1/Month
	~		|

Human Population employed=Human Population*0.25
	~	People
	~		|

informal settlement preference=0.02
	~	Dmnl
	~		|

infrastructure development index=
	RANDOM UNIFORM ( 0.024 ,0.058 ,1000 )
	~	1/Month
	~		|

Total Human deaths=Total VBDs deaths
	~	People
	~		|

sewage treatment frequency=(RANDOM UNIFORM ( 10 , 20 , 1000 ) )/365
	~	Month
	~		|

Region Initial Dengue incidence=0.001
	~	Dmnl
	~		|

Region Area=
	1e+06
	~	m2
	~		|

Waste per population=
	(RANDOM UNIFORM(0.3, 0.1, 1000))/1000
	~	Dmnl
	~		|

Region human management probability=Human population density*0.025
	~	People/m2
	~		|

Drainage coverage=
	1
	~	Dmnl
	~		|

Waste accumulation=1000
	~	1/Month
	~		|

Aedes Control measures=
	(((Treatment Measures Index*VBD Awareness index)*Sanitation index))
	~	Dmnl
	~	Number of control measures/year
	|

Human population density=Human Population/Region Area
	~	People/m2
	~		|

Dengue Climate factor=
	((Regional Precipitation-Deng Rainfall)/Regional Precipitation)+((Regional Humidity-\
		Deng Humidity)/Regional Humidity)+((Regional Temperature-Dengue Temp)/Regional Temperature\
		)
	~	Dmnl
	~		|

Dengue Prefered climate=
	IF THEN ELSE((Optimal Aedes VBD Climate effect:AND:Dengue Climate factor>=1), RANDOM UNIFORM\
		(0.5, 1 , 100), 0)
	~	Month
	~		|

Breeding site rain= WITH LOOKUP (
	Regional Precipitation,
		([(0,0)-(500,10)],(0,0),(20,0.001),(40,0.04),(60,0.09),(80,0.3),(100,0.8),(150,1),(\
		200,0.9),(250,0.8),(300,0.001),(500,0) ))
	~	Month
	~		|

Host Daytime exposure=5/24
	~	1/Month
	~	Early morning and evening hours =
	|

Availability of blood=(Human Blood Preference+Livestock blood preference)*Aedes siting in region
	~	1/Month
	~		|

Risk of Dengue Infection= INTEG (
	Deng Human contact infection rate-Dengue prevention rate,
		0)
	~	Dmnl
	~		|

Probability of infected dengue vector from biting infected human=
	1
	~	Dmnl
	~		|

Dengue Infected Aedes region density=
	DengV Infected Aedes Adults/Aedes Adults
	~	Dmnl
	~		|

Aedes ready to bite humans=
	Susceptible Female Aedes Adults*Factor Adjusting exposition
	~	Aedes
	~		|

Aedes Deng infectious rate=DengV Exposed Aedes Adults/DenV Extrinsic Incubation period
	~	Aedes/Month
	~		|

DenV Exposed mortality rate=DengV Exposed Aedes Adults*DenV Vector Exposed deaths
	~	Aedes/Month
	~		|

DengV Infected Aedes Adults= INTEG (
	Aedes Deng infectious rate-DenV induced Mortality rate,
		0)
	~	Aedes
	~		|

DenV induced Mortality rate=DengV Infected Aedes Adults*DenV Vector Infected deaths
	~	Aedes/Month
	~		|

Aedes S mortality rate=Aedes Female Susceptible mortality factor*Susceptible Female Aedes Adults
	~	Aedes/Month
	~		|

females ready to bite=0.9
	~	1/Month
	~		|

Breeding habitat characteristics preference=0.1
	~	Dmnl
	~	Which kind of materials are used as sites: Tyres, water potholes, lakes, \
		containers, flowers
	|

Human birth rate=
	Human births*Human Population
	~	People/Month
	~		|

Human Blood Preference= WITH LOOKUP (
	Human Population/1000,
		([(0,0)-(200,10)],(1,0.1),(10,0.3),(30,0.9),(50,1.5),(100,2.5),(150,3.2),(200,3.6) \
		))
	~	Dmnl
	~		|

Human Death rate=Human Population/Human lifespan
	~	People/Month
	~		|

Livestock blood preference= WITH LOOKUP (
	Livestock Population,
		([(0,0)-(10,10)],(0,0),(0.5,0.3),(1,0.8),(1.5,1.2),(2.5,1.8),(4,2.2807),(5.84098,2.7193\
		),(7.67584,3.55263),(8.96024,3.77193),(9.93884,4.42982) ))
	~	Dmnl
	~		|

Factor Adjusting exposition=
	1
	~	Dmnl
	~		|

Number of bites per Aedes per month=
	1.0087*4
	~	1/Month
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

Waste removal rate=
	Sanitation index*(Drainage coverage/sewage treatment frequency)*Urban sanitation effect
	~	1/Month
	~		|

Region urban growth=
	((Economic growth index+Infrastructure formation))
	~	Dmnl
	~		|

Aedes Carrying capacity=
	Aedes Carrying capacity maximum*(Regional Precipitation/Rainfall threshold)*Aedes Suitability Index
	~	Aedes
	~	1+Carrying capacity maximum*(Rainfall/(Rainfall threshold*Rain accumulation time))
		+Carrying capacity maximum+((DELAY N(Rainfall, Rain accumulation time, 10, \
		2))/(Rainfall threshold^0.5))*Carrying capacity maximum
	|

Aedes Region Suitability=
	Aedes Suitability Index*(IF THEN ELSE ( Aedes Climate development effect>=1 , (Aedes siting in region\
		*Breeding site rain) , 0.007 ))
	~	Dmnl
	~		|

Average monthly number of eggs per female=
	(Mean number of eggs laid per day/Temp effect on Egg laying)*TIME STEP
	~	1/Month
	~		|

Adjusting factor humidity mean egg=
	30
	~	1/Month
	~		|

Aedes Adults= INTEG (
	Aedes Adults dvpt rate-Aedes mortality rate,
		2)
	~	Aedes
	~		|

Aedes mortality=
	(RANDOM UNIFORM(8, 15, 1000))/30
	~	1/Month
	~		|

Total Aedes female mosquitos=
	IF THEN ELSE(Aedes Adults>Aedes Carrying capacity, (Aedes Carrying capacity*Sex ratio after emergence\
		*0.001), (Aedes Adults*Sex ratio after emergence))
	~	Aedes
	~	MAX ( (Aedes Adults*Sex ratio after emergence) , (1*Sex ratio after \
		emergence) )
	|

Aedes egg formation rate=
	Percentage of females laying eggs*Total Aedes female mosquitos*Oviposition rate
	~	Aedes/Month
	~		|

Aedes mortality rate=
	Aedes Adults*Aedes mortality
	~	Aedes/Month
	~		|

Temp effect on Egg laying= WITH LOOKUP (
	Regional Temperature,
		([(0,0)-(35,10)],(20,4),(25,3),(30,2),(35,1.9) ))
	~	Dmnl
	~		|

Oviposition rate=
	Average monthly number of eggs per female*Aedes Breeding Site
	~	1/Month
	~		|

Egg2Larval=
	(RANDOM UNIFORM(0.46,0.6, 1000))
	~	1/Month
	~		|

DenV Extrinsic Incubation period= WITH LOOKUP (
	Regional Temperature*Temp effect,
		([(0,0)-(40,40)],(0,0),(10,20),(15,15),(20,8),(22,5),(24,4),(28,2.8),(30,2.2),(35,5\
		),(40,5) ))
	~	Month
	~		|

Habitat Availability Index=(Sanitation index/(1+Land Use changes))*(Breeding site nature\
		)
	~	Dmnl
	~		|

Aedes Eggs= INTEG (Aedes egg formation rate-Aedes Larva dvpt rate-Ae Egg mortality rate\
		,
		0)
	~	Aedes
	~		|

Deng Aedes Competence=(Number of bites per Aedes per month*Dengue Prefered climate)
	~	Dmnl
	~		|

Optimal Rainfall Ae=
	RANDOM UNIFORM(100, 150, 1000)
	~	Dmnl
	~		|

Breeding site elimination rate=Aedes Breeding Site*Control Measures implemetation*Aedes Habitat Survival probability
	~	1/Month
	~		|

Optimal Humidity Ae=
	RANDOM UNIFORM( 72, 77, 1000)
	~	Dmnl
	~		|

Climate effect impact Ae=
	((Optimal Humidity Ae/Regional Humidity)+(Optimal Rainfall Ae/Regional Precipitation\
		)+(Optimal temp Ae/Regional Temperature))/3
	~	Dmnl
	~		|

Optimal temp Ae=
	RANDOM UNIFORM(24, 26, 1000)
	~	Dmnl
	~		|

Deng Vector to human contact=Dengue Infected Aedes region density*(Host Daytime exposure\
		)
	~	1/Month
	~		|

Emerging females=Total Aedes female mosquitos*females ready to bite
	~	Aedes/Month
	~		|

Breeding site creation rate=(Aedes Region Suitability+Habitat Availability Index)*Availability of blood
	~	1/Month
	~		|

Land Use changes=(Urbanization Index*Social networks impact)*Forest coverage
	~	Dmnl
	~		|

Hatching rate at humidity 80= WITH LOOKUP (
	Regional Temperature,
		([(0,0)-(35,10)],(25,0.58),(30,0.7),(35,0.43) ))
	~	Dmnl
	~		|

Percentage of females laying eggs=
	IF THEN ELSE(Regional Humidity <60, "Percentage of females laying eggs at 60%", IF THEN ELSE\
		(Regional Humidity>60:AND:Regional Humidity
	<80, ("Percentage of females laying eggs at 60%"+(("Percentage of females laying eggs at 80%"\
		-"Percentage of females laying eggs at 60%"
	)/20)*(Regional Humidity-60)), "Percentage of females laying eggs at 80%"))
	~	Dmnl
	~		|

Adjusting factor humidity hatching rate=
	1
	~	Dmnl
	~		|

Aedes Breeding Site= INTEG (
	Breeding site creation rate-Breeding site elimination rate,
		0.001)
	~	Dmnl
	~		|

Aedes Climate development effect=IF THEN ELSE (Climate effect impact Ae>1:AND:Climate effect impact Ae\
		<3 , 1 , 0 )
	~	Dmnl
	~		|

Aedes siting in region=RANDOM UNIFORM(0, 0.5, 1000)
	~	1/Month
	~		|

Aedes Carrying capacity maximum=
	RANDOM UNIFORM(4500, 10000, 1000)
	~	Aedes
	~	Consider 10-45 mosquitos per household. A region of 1km2 can have more \
		than 100 households.
	|

Forest coverage=RANDOM UNIFORM ( 0.003 ,0.4 , 1000 )
	~	Dmnl
	~		|

Hatching rate=IF THEN ELSE(Regional Humidity<60, (Hatching rate at humidity 60*Adjusting factor humidity hatching rate\
		), IF THEN ELSE(Regional Humidity>=60:AND:Regional Humidity<80, ((Hatching rate at humidity 60\
		+(Hatching rate at humidity 80-Hatching rate at humidity 60))*(
	Regional Humidity-60)/20)*Adjusting factor humidity hatching rate, (Hatching rate at humidity 80\
		*Adjusting factor humidity hatching rate
	)))
	~	Dmnl
	~	Adjusting factor humidity hatching rate*(IF THEN ELSE((Humidity<=70), \
		Hatching rate at humidity 60, Hatching rate at humidity 80))
	|

Hatching rate at humidity 60= WITH LOOKUP (
	Regional Temperature,
		([(0,0)-(35,10)],(25,0.62),(30,0.58),(35,0.43) ))
	~	Dmnl
	~		|

Rainfall threshold=
	100
	~	Dmnl
	~		|

Mean eggs at humidity 60= WITH LOOKUP (
	Regional Temperature,
		([(0,0)-(35,70)],(24,54),(27,62),(30,53),(35,54) ))
	~	Dmnl
	~		|

Mean eggs at humidity 80= WITH LOOKUP (
	Regional Temperature,
		([(0,0)-(35,70)],(24,55),(27,64),(30,54),(35,54) ))
	~	Dmnl
	~		|

Mean number of eggs laid per day=IF THEN ELSE(Regional Humidity<=60, Mean eggs at humidity 60\
		, IF THEN ELSE(Regional Humidity>60:AND:Regional Humidity<80, (Mean eggs at humidity 60
	+((Mean eggs at humidity 80-Mean eggs at humidity 60)/20)*(Regional Humidity-60)), Mean eggs at humidity 80\
		))*Adjusting factor humidity mean egg
	~	1/Month
	~	(IF THEN ELSE((Humidity<=70), Mean eggs at humidity 60, Mean eggs at \
		humidity 80))*Adjusting factor humidity mean egg
	|

Optimal Aedes VBD Climate effect=
	Climate effect impact Ae
	~	Dmnl
	~		|

"Percentage of females laying eggs at 60%"= WITH LOOKUP (
	Regional Temperature,
		([(0,0)-(35,10)],(10,0),(25,0.38),(30,0.684),(35,0.45) ))
	~	Dmnl
	~		|

"Percentage of females laying eggs at 80%"= WITH LOOKUP (
	Regional Temperature,
		([(0,0)-(35,10)],(25,0.53),(30,0.74),(35,0.685) ))
	~	Dmnl
	~		|

Regional Precipitation:INTERPOLATE::=GET XLS DATA('Mombasa Climate2015_2065.xlsx', 'Climate_monthly_ensemble'\
		, 'C', 'E2')
	~	Dmnl
	~		|

Regional Humidity:INTERPOLATE::=GET XLS DATA('Mombasa Climate2015_2065.xlsx', 'Climate_monthly_ensemble'\
		, 'C', 'F2')
	~	Dmnl
	~		|

Sex ratio after emergence=
	0.5
	~	Dmnl
	~		|

Regional Temperature:INTERPOLATE::=GET XLS DATA('Mombasa Climate2015_2065.xlsx', 'Climate_monthly_ensemble'\
		, 'C', 'I2')
	~	Dmnl
	~		|

Sanitation index= INTEG (waste accumulation rate-Waste removal rate,
		0.1)
	~	Dmnl
	~		|

Aedes Habitat Survival probability=0.907
	~	1/Month
	~		|

Social networks impact=RANDOM UNIFORM ( 0.4 , 0.8 , 1000)
	~	Dmnl
	~		|

FINAL TIME  = 599
	~	Month
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Month
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Month [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.25
	~	Month [0,?]
	~	The time step for the simulation.
	|

