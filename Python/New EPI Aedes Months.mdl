{UTF-8}
Additional Ae mortality=
	Adult Ae*Suppression factor*Suppression Month value
	~	Aedes/Month
	~		|

H D Infections=
	Susceptible Humans*Force of infection H Dengue
	~	People/Month
	~		|

H Deaths=
	Susceptible Humans/Life expectancy
	~	People/Month
	~		|

H YF Infections=
	Susceptible Humans*Force of infection H YellowFever
	~	People/Month
	~		|

D Reproduction Number Ae=
	(Biting rate ae^2)*Human feeding fraction ae*Transmission prob D H to M ae*Transmission prob D M to H ae\
		*(Total Adult Ae
	/Human population 1)*EXP( -(Adult Mortality rate ae*EIP D Ae))/(Adult Mortality rate ae\
		*Recovery rate H)
	~	
	~		|

D Reproduction Number Albo=
	(Biting rate albo^2)*Human feeding fraction albo*Transmission prob D H to M albo*Transmission prob D M to H albo\
		*(Total Adult Albo
	/Human population 1)*EXP( -(Adult Mortality rate albo*EIP D Albo))/(Adult Mortality rate albo\
		*Recovery rate H)
	~	1/Aedes
	~		|

Dengue become Infectious Ae=
	Exposed Dengue Ae/EIP D Ae
	~	Aedes/Month
	~		|

Dengue become Infectious Albo=
	Exposed Dengue ALbo/EIP D Albo
	~	Aedes/Month
	~		|

Human feeding fraction ae=
	0.9/30
	~	Dmnl
	~		|

Human feeding fraction albo=
	0.6/30
	~	Dmnl
	~		|

Adult Mortality rate ae=
	1/Adult life ae
	~	1/Month
	~		|

Adult Mortality rate ae Chi=
	1/Adult life ae
	~	1/Month
	~		|

Adult Mortality rate ae YF=
	1/Adult life ae
	~	1/Month
	~		|

