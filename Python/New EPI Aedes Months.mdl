Rainfall:INTERPOLATE::=GET XLS DATA('Mombasa Climate2015_2065.xlsx', 'Climate_monthly_ensemble'\
		, 'C', 'E2')
	~	Month
	~		|

Egg duration Ae=5/30
	~	1/Month
	~		|

Egg duration Albo=5/30
	~	1/Month
	~		|

Eggs per female ae=
	10
	~	Month
	~		|

Temperature:INTERPOLATE::=GET XLS DATA('Mombasa Climate2015_2065.xlsx', 'Climate_monthly_ensemble'\
		, 'C', 'I2')
	~	Month
	~		|

Temperature Suitability Ae=
	EXP(-((Temperature-30)^2)/50)
	~	1/Month
	~		|

Hatching Ae=Egg Ae*Egg duration Ae
	~	Aedes/Month
	~		|

Hatching Albo=Egg Albo*Egg duration Albo
	~	Aedes/Month
	~		|

Suppression factor=
	MIN(1, Adult Albo/(Adult Albo+Adult Ae+1))
	~	Dmnl
	~		|

Larva Ae= INTEG (
	Hatching Ae-Larval mortality ae-Pupation Ae,
		500)
	~	Aedes
	~		|

Pupa duration Ae=
	2/30
	~	1/Month
	~		|

Larva duration Ae=
	8/30
	~	1/Month
	~		|

Larva duration Albo=
	9/30
	~	1/Month
	~		|

Larval mortality ae=
	(Competition pressure ae*Larva Ae*0.1)*Priority Effect Ae
	~	Aedes/Month
	~		|

Larval mortality albo=
	(Competition pressure albo*Larva Albo*0.08)*Priority effect albo
	~	Aedes/Month
	~		|

Priority Index=
	(Adult Albo-Adult Ae)/(Adult Albo+Adult Ae+1)
	~	Dmnl
	~		|

Pupa Ae= INTEG (
	Pupation Ae-Adult Emergence Ae,
		200)
	~	Aedes
	~		|

Temp Suitability Albo=
	EXP(-((Temperature-27)^2)/60)
	~	1/Day
	~	Albopictus is assigned a lower optimum temperature to reflect better \
		adaption to cooler highland conditions
	|

Priority effect albo=
	MAX( 0 , (1+Priority Index))
	~	Dmnl
	~		|

Oviposition Ae=
	Adult Ae*Eggs per female ae*Temperature Suitability Ae
	~	Aedes/Month
	~		|

Priority Effect Ae=
	MAX( 0 , (1-Priority Index))
	~	Dmnl
	~		|

Suppression Month value=
	0.01
	~	1/Month
	~		|

Pupation Albo=
	Larva Albo*Larva duration Albo
	~	Aedes/Month
	~		|

Urbanization index=
	0.5
	~	Dmnl
	~		|

Base carrying capacity=
	10000
	~	Aedes
	~		|

Container Density=
	100
	~	Dmnl
	~		|

Habitat Suitability Ae=
	MIN(1, 0.3+(0.4*Urbanization index)+(0.3*(Rainfall/100)))
	~	Dmnl
	~		|

Habitat Suitability Albo=
	MIN(1, (0.4*Organic matter index)+(0.2*Urbanization index)+(0.4*(Rainfall/100)))
	~	Dmnl
	~		|

Organic matter index=
	0.5
	~	Dmnl
	~		|

Adult Albo= INTEG (
	Adult Emergence Albo-Adult Mortality ALbo,
		100)
	~	Aedes
	~		|

Egg Albo= INTEG (
	Oviposition Albo-Hatching Albo,
		1000)
	~	Aedes
	~		|

Pupa Albo= INTEG (
	Pupation Albo-Adult Emergence Albo,
		200)
	~	Aedes
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 611
	~	Month
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Month
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Month [0,?]
